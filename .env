# ============================================================
# Paper-Copilot 环境变量配置
# ============================================================
# 请根据你的实际环境修改以下配置

# ============================================================
# LLM API — DeepSeek（Chat 模型）
# ============================================================
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-3a16a263eea944cb85ecc428f27613e7
LLM_MODEL_NAME=deepseek-v4-pro

# ============================================================
# Embedding 模型 — 在线 API（SiliconFlow 硅基流动，国内可访问，免费额度）
# ============================================================
# 提供方: "local" | "openai"
#   - local:  使用 HuggingFace 本地模型（需下载 ~400MB）
#   - openai: 使用 OpenAI 兼容 Embedding API
EMBEDDING_PROVIDER=openai

# SiliconFlow 硅基流动（注册即送免费额度，国内直连）
# 注册地址: https://siliconflow.cn
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-vyorljmisiaqgeijmcezljdlsxtdajkhjmdzpcrachnlkizq
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-4B

# 仅 EMBEDDING_PROVIDER=local 时生效
LOCAL_EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5

# 本地论文存储目录
PAPERS_DIR=D:/liyuanbo/myDoc/Info-Master/收集论文

# HuggingFace 国内镜像（解决模型下载问题）
HF_ENDPOINT=https://hf-mirror.com

# 向量数据库
VECTOR_DB_PATH=./data/vector_store

# PDF 切片参数
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# 应用配置
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=50
MAX_RETRIES=3
RETRY_DELAY=1.0

# Agent 参数
AGENT_MAX_ITERATIONS=8
RETRIEVAL_TOP_K=8
LLM_TEMPERATURE=0.1

