# ============================================================
# Paper-Copilot 环境变量配置模板
# ============================================================
# 使用方式:
#   1. 复制本文件为 .env:
#      cp .env.example .env
#   2. 根据实际环境修改 .env 中的配置值
#   3. 启动应用: python app.py
#
# 注意: .env 文件包含敏感信息（API_KEY 等），请勿提交到版本控制系统。
#       确保 .gitignore 中包含 .env
# ============================================================

# ============================================================
# LLM API 配置（兼容 OpenAI API 格式）
# ============================================================
# API 基础 URL
#   - DeepSeek:    https://api.deepseek.com/v1
#   - OpenAI 官方: https://api.openai.com/v1
#   - 本地 Ollama:  http://localhost:11434/v1
#   - 其他平替服务: 填入对应地址
LLM_BASE_URL=https://api.deepseek.com/v1

# API 认证密钥
LLM_API_KEY=sk-your-api-key-here

# 聊天模型名称
#   - DeepSeek: deepseek-chat
#   - OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
#   - 本地: llama3, qwen2.5 等
LLM_MODEL_NAME=deepseek-chat

# ============================================================
# Embedding 模型配置
# ============================================================
# 提供方: "openai" | "local"
#   - openai: 使用 OpenAI 兼容的远程 Embedding API
#   - local:  使用 HuggingFace 本地模型（推荐 DeepSeek 用户，免费）
EMBEDDING_PROVIDER=local

# openai 模式下的模型名（EMBEDDING_PROVIDER=openai 时生效）
EMBEDDING_MODEL_NAME=text-embedding-3-small

# local 模式下的 HuggingFace 模型 ID（EMBEDDING_PROVIDER=local 时生效）
LOCAL_EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5

# ============================================================
# 向量数据库配置
# ============================================================
# Chroma 向量库本地持久化路径（相对于项目根目录）
VECTOR_DB_PATH=./data/vector_store

# ============================================================
# PDF 文本切片参数
# ============================================================
# 每个文本块的字符数上限（可根据模型上下文窗口调整）
CHUNK_SIZE=1000

# 相邻块之间的重叠字符数（保持语义连贯性）
CHUNK_OVERLAP=200

# ============================================================
# 应用级配置
# ============================================================
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# PDF 上传大小上限 (MB)
MAX_UPLOAD_SIZE_MB=50

# 网络操作最大重试次数
MAX_RETRIES=3

# 重试间隔（秒）
RETRY_DELAY=1.0

# ============================================================
# Agent 配置
# ============================================================
# Agent 最大推理迭代次数（防止无限循环）
AGENT_MAX_ITERATIONS=5

# 检索工具返回的最相关文档数
RETRIEVAL_TOP_K=5

# LLM 温度参数（0.0-2.0）
#   0.0 = 完全确定性（适合事实性问答）
#   0.5 = 适中
#   1.0+ = 更有创造性（不适合学术场景）
LLM_TEMPERATURE=0.1
